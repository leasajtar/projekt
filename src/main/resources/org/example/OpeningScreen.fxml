<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="720.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.screen.OpeningScreenController">
   <children>
      <BorderPane prefHeight="720.0" prefWidth="1024.0">
         <top>
            <VBox alignment="CENTER" prefHeight="150.0" prefWidth="600.0" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" text="Welcome" textAlignment="CENTER">
                     <font>
                        <Font name="System Bold" size="51.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </top>
         <center>
            <VBox alignment="CENTER" prefHeight="240.0" prefWidth="512.0" BorderPane.alignment="CENTER">
               <children>
                  <Label text="Data">
                     <font>
                        <Font size="24.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="bookingDataBtn" mnemonicParsing="false" onAction="#goToBookings" text="Bookings">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="minMaxBataBTN" mnemonicParsing="false" onAction="#goToPrice" text="Min/Max Price">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Label text="Enter data">
                     <font>
                        <Font size="24.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Button fx:id="userEnterBtn" mnemonicParsing="false" onAction="#goToUserAdd" text="User">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="itemEnterBtn" mnemonicParsing="false" onAction="#goToItemAdd" text="Item">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </Button>
                  <Button fx:id="bookingEnterBtn" mnemonicParsing="false" onAction="#goToBookingAdd" text="Booking">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </center>
         <left>
            <VBox prefHeight="240.0" prefWidth="256.0" BorderPane.alignment="CENTER" />
         </left>
         <right>
            <VBox alignment="TOP_CENTER" prefHeight="240.0" prefWidth="256.0" BorderPane.alignment="CENTER">
               <children>
                  <Label contentDisplay="CENTER" text="Event deals:" textAlignment="CENTER">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <TableView fx:id="eventDetailsTbl" prefHeight="295.0" prefWidth="152.0">
                    <columns>
                      <TableColumn fx:id="eventNameTblCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="115.733154296875" text="Name" />
                        <TableColumn fx:id="eventPriceTblCol" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="115.733154296875" text="Price" />
                    </columns>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                  </TableView>
               </children>
            </VBox>
         </right>
          <bottom>
              <VBox fx:id="latestBookingBox" alignment="CENTER" prefHeight="80.0" BorderPane.alignment="CENTER">
                  <children>
                      <Label fx:id="latestBookingLbl" text="Loading latest booking..." />
                  </children>
              </VBox>
          </bottom>

      </BorderPane>
   </children>
</AnchorPane>
