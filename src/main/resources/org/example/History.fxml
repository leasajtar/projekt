<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.screen.HistoryController"
      spacing="10.0" prefWidth="1024.0" prefHeight="720.0">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Live Activity (auto-refreshing thread)" />
        <ListView fx:id="activityListView" prefHeight="220.0" />

        <HBox spacing="10.0">
            <children>
                <Button fx:id="saveSnapshotBtn" text="Save Snapshot Now (backup.bin)" onAction="#handleSaveSnapshot" />
                <Button fx:id="loadHistoryBtn" text="Reload History From backup.bin" onAction="#loadBackupHistory" />
            </children>
        </HBox>

        <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="History loaded from backup.bin" />
        <ListView fx:id="backupListView" VBox.vgrow="ALWAYS" />
    </children>
</VBox>